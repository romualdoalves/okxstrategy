# Copy this file to .env on the VPS and fill in real credentials.
# Do not commit or publish real secrets.

EXCHANGE_PROVIDER=okx
OKX_DEMO=true

DEEPSEEK_API_KEY=
ETHERSCAN_API_KEY=

# Fábrica de Estratégias — LLM para geração de código
# Usa DEEPSEEK_API_KEY automaticamente como fallback se FACTORY_LLM_KEY não for definida.
# Para usar DeepSeek (padrão): deixe FACTORY_LLM_KEY vazio e preencha DEEPSEEK_API_KEY.
# Para usar outro provedor: defina as 3 variáveis abaixo.
FACTORY_LLM_KEY=
FACTORY_LLM_BASE_URL=https://api.deepseek.com
FACTORY_LLM_MODEL=deepseek-chat

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=6753071411

POSTGRES_PASSWORD=crypto
DATABASE_URL=postgresql://crypto:crypto@postgres:5432/okx_strategy

# Segurança da API — OBRIGATÓRIO fora do localhost (Docker/VPS).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem este token, a API só aceita clientes loopback (fail-closed).
API_AUTH_TOKEN=
# Origens permitidas no CORS, separadas por vírgula (padrão: localhost:5173 e :8000)
CORS_ORIGINS=

# Chave de criptografia das credenciais da OKX guardadas no banco. Sem ela, a proteção
# depende só de POSTGRES_PASSWORD. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Guarde uma cópia fora do servidor: se perder, é preciso reconectar a conta OKX.
# Ao definir, valores antigos são reencriptados automaticamente no próximo startup.
ENCRYPTION_KEY=
